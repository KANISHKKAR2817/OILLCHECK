# PillCheck Environment Configuration Template
PROJECT_NAME="PillCheck"
VERSION="1.0.0"
ENGINE_VERSION="2.1.0"

# Application Security
SECRET_KEY="generate-a-strong-random-secret-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./pillcheck.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://pillcheck_user:securepassword@localhost:5432/pillcheck_db"

# Storage & Upload Limits
MAX_UPLOAD_SIZE_MB=15
BLUR_THRESHOLD=80.0
RATE_LIMIT_PER_MINUTE=120

# Optional explicit Tesseract path (leave empty for auto-discovery)
TESSERACT_CMD=""
